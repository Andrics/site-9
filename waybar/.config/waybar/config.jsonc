// waybar/.config/waybar/config.jsonc
// Half-Life / Black Mesa readout style — icons + HUD-style text labels.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/volume", "network", "battery", "tray"],

    "group/volume": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 150
        },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "vertical"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },

    "pulseaudio": {
        "format": "{icon} VOL: {volume}%",
        "format-muted": " VOL: MUTE",
        "format-icons": { "default": ["", "", ""] }
        // on-click-right (mute) removed for a diagnostic test per THE
        // OVERSEER: checking whether the leader swallows the reveal click
        // just by having *any* on-click-* bound, not only on left-click.
        // Mute is temporarily unreachable via click — restore once this
        // test reports back. See PHASES.md Phase 1 "Still open".
    },

    "network": {
        "format-wifi": " NET: {signalStrength}%",
        "format-ethernet": " NET: LINK",
        "format-disconnected": " NET: OFFLINE",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "battery": {
        "format": "{icon} PWR: {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": { "warning": 25, "critical": 10 }
    },

    "tray": {
        "spacing": 8
    }
}

