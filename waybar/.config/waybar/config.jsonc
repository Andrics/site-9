// waybar/.config/waybar/config.jsonc
// Half-Life / Black Mesa readout style — icons + HUD-style text labels.
{
    "layer": "top",
    "position": "top",
    // Set explicitly: natural height is 24px; 30 gives the frames a gap
    // from the bar edge.
    "height": 30,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["custom/site", "hyprland/workspaces"],
    "modules-center": ["clock", "custom/met"],
    "modules-right": ["cpu", "memory", "group/volume", "network", "battery", "tray"],

    // Static tag: no exec, drawn once, never starts a process.
    "custom/site": {
        "format": "SITE-9",
        "interval": "once",
        "tooltip": false
    },

    // Mission clock: system uptime as T+DDD:HH:MM. No seconds — they'd
    // sit stale between 60s updates.
    "custom/met": {
        "exec": "awk '{s=int($1); printf \"T+%03d:%02d:%02d\\n\", s/86400, (s%86400)/3600, (s%3600)/60}' /proc/uptime",
        "interval": 60,
        "tooltip": false
    },

    // Percentages use a fmt width spec ({usage:>3}) so readouts keep one
    // width from 0% to 100%; min-length would pad the whole label instead.
    "cpu": {
        "interval": 10,
        "format": "CPU: {icon} {usage:>3}%",
        // DOS-fill bar: entry i lights i+1 of 10 cells. Empty cells are
        // █ in --border (#3a3626) inside a pango span.
        "format-icons": [
            "█<span color='#3a3626'>█████████</span>",
            "██<span color='#3a3626'>████████</span>",
            "███<span color='#3a3626'>███████</span>",
            "████<span color='#3a3626'>██████</span>",
            "█████<span color='#3a3626'>█████</span>",
            "██████<span color='#3a3626'>████</span>",
            "███████<span color='#3a3626'>███</span>",
            "████████<span color='#3a3626'>██</span>",
            "█████████<span color='#3a3626'>█</span>",
            "██████████"
        ]
    },

    "memory": {
        "interval": 30,
        "format": "RAM: {icon} {percentage:>3}%",
        // DOS-fill bar: entry i lights i+1 of 10 cells. Empty cells are
        // █ in --border (#3a3626) inside a pango span.
        "format-icons": [
            "█<span color='#3a3626'>█████████</span>",
            "██<span color='#3a3626'>████████</span>",
            "███<span color='#3a3626'>███████</span>",
            "████<span color='#3a3626'>██████</span>",
            "█████<span color='#3a3626'>█████</span>",
            "██████<span color='#3a3626'>████</span>",
            "███████<span color='#3a3626'>███</span>",
            "████████<span color='#3a3626'>██</span>",
            "█████████<span color='#3a3626'>█</span>",
            "██████████"
        ]
    },

    "group/volume": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 150
        },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },

    "pulseaudio": {
        // Scroll on VOL: 5% a step, same as the media keys.
        "scroll-step": 5,
        "format": "◄ VOL: {icon} {volume:>3}%",
        "format-muted": "◄ VOL: MUTE",
        // DOS-fill bar: entry i lights i+1 of 10 cells. Empty cells are
        // █ in --border (#3a3626) inside a pango span.
        "format-icons": {
            "default": [
                "█<span color='#3a3626'>█████████</span>",
                "██<span color='#3a3626'>████████</span>",
                "███<span color='#3a3626'>███████</span>",
                "████<span color='#3a3626'>██████</span>",
                "█████<span color='#3a3626'>█████</span>",
                "██████<span color='#3a3626'>████</span>",
                "███████<span color='#3a3626'>███</span>",
                "████████<span color='#3a3626'>██</span>",
                "█████████<span color='#3a3626'>█</span>",
                "██████████"
            ]
        }
        // No on-click* here: any click binding on the drawer leader
        // swallows the reveal click. Mute lives on XF86AudioMute in
        // hyprland.lua.
    },

    "network": {
        "format-wifi": "{icon} NET: {signalStrength:>3}%",
        "format-ethernet": "NET: LINK",
        "format-disconnected": "NET: OFFLINE",
        // Signal steps: entry i lights i+1 of ▂▄▆█. Unlit steps in
        // --border (#3a3626) inside a pango span.
        "format-icons": [
            "▂<span color='#3a3626'>▄▆█</span>",
            "▂▄<span color='#3a3626'>▆█</span>",
            "▂▄▆<span color='#3a3626'>█</span>",
            "▂▄▆█"
        ],
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "battery": {
        "format": "⏻ PWR: {icon} {capacity:>3}%",
        "format-charging": "⏻ CHG: {icon} {capacity:>3}%",
        // DOS-fill bar: entry i lights i+1 of 10 cells. Empty cells are
        // █ in --border (#3a3626) inside a pango span.
        "format-icons": [
            "█<span color='#3a3626'>█████████</span>",
            "██<span color='#3a3626'>████████</span>",
            "███<span color='#3a3626'>███████</span>",
            "████<span color='#3a3626'>██████</span>",
            "█████<span color='#3a3626'>█████</span>",
            "██████<span color='#3a3626'>████</span>",
            "███████<span color='#3a3626'>███</span>",
            "████████<span color='#3a3626'>██</span>",
            "█████████<span color='#3a3626'>█</span>",
            "██████████"
        ],
        "states": { "warning": 29, "critical": 14 }
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}

