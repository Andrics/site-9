// waybar/.config/waybar/config.jsonc
// Half-Life / Black Mesa readout style — icons + HUD-style text labels.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery", "tray"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },

    "pulseaudio": {
        // Label hardcoded to --text-dim (#8f8a76) — pango <span> inside a
        // format string can't be reached by GTK CSS.
        "format": "{icon} <span color='#8f8a76'>VOL:</span> {volume}%",
        // Label hardcoded to --text-dim (#8f8a76) — same reason as above.
        "format-muted": " <span color='#8f8a76'>VOL:</span> MUTE",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        // Label hardcoded to --text-dim (#8f8a76) — pango <span> can't be
        // reached by GTK CSS.
        "format-wifi": " <span color='#8f8a76'>NET:</span> {signalStrength}%",
        // Label hardcoded to --text-dim (#8f8a76) — same reason as above.
        "format-ethernet": " <span color='#8f8a76'>NET:</span> LINK",
        // Label hardcoded to --critical (#b8452e) — disconnect is a
        // whole-module alert, so the label shouts too instead of staying
        // dim like the other states.
        "format-disconnected": " <span color='#b8452e'>NET:</span> OFFLINE",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "battery": {
        // Label hardcoded to --text-dim (#8f8a76) — pango <span> can't be
        // reached by GTK CSS; #battery.warning/.critical still colors the
        // value and box via CSS.
        "format": "{icon} <span color='#8f8a76'>PWR:</span> {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": { "warning": 25, "critical": 10 }
    },

    "tray": {
        "spacing": 8
    }
}

