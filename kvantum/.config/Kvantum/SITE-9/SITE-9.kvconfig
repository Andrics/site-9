; kvantum/.config/Kvantum/SITE-9/SITE-9.kvconfig
; SITE-9 Kvantum theme (BUILD_SPEC.md §3 "Locked Qt theme: Dolphin") —
; the same widget rules as the GTK3 theme. Elements live in SITE-9.svg,
; generated by tools/make-svg.py. Keys checked against Kvantum 1.1.8's
; Theme-Config. Missing keys fall back to Kvantum's default theme, so
; everything §2 bans is switched off explicitly here.
;
; Colors: --panel #445435, --field #303f25, --bevel-light #667359,
; --bevel-dark #1f2719, --text #cbcfc8, --text-bright #ffffff,
; --text-dim #8f9a85.

[%General]
author=SITE-9
comment=Half-Life VOX console look (SITE-9 tokens)
respect_DE=false
x11drag=none
alt_mnemonic=true
; --- §2: no translucency, blur, shadows or state animation
composite=false
translucent_windows=false
reduce_window_opacity=0
reduce_menu_opacity=0
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
shadowless_popup=true
animate_states=false
no_inactiveness=true
no_window_pattern=true
; --- Sizes
scroll_width=12
scroll_min_extent=24
scroll_arrows=false
transient_scrollbar=false
scrollbar_in_view=false
splitter_width=4
slider_width=6
slider_handle_width=9
slider_handle_length=16
check_size=13
menu_separator_height=7
spin_button_width=16
layout_spacing=4
layout_margin=4
; --- Tabs: square, left-aligned, the open one pressed in
left_tabs=true
joined_inactive_tabs=false
attach_active_tab=false
bold_active_tab=false
; --- Other
tree_branch_line=false
fill_rubberband=false
groupbox_top_label=true
combo_menu=false
square_combo_button=true
toolbutton_style=0
tooltip_delay=-1
submenu_delay=250

[GeneralColors]
; --panel
window.color=#445435
; --field
base.color=#303f25
alt.base.color=#303f25
; --panel
button.color=#445435
; --bevel-light
light.color=#667359
mid.light.color=#667359
; --bevel-dark
dark.color=#1f2719
mid.color=#1f2719
shadow.color=#1f2719
; --panel (selected rows, as menus/lists)
highlight.color=#445435
inactive.highlight.color=#445435
; --field
tooltip.base.color=#303f25
; --text
text.color=#cbcfc8
window.text.color=#cbcfc8
button.text.color=#cbcfc8
tooltip.text.color=#cbcfc8
; --text-dim (disabled, pick e)
disabled.text.color=#8f9a85
; --text-bright
highlight.text.color=#ffffff
link.color=#ffffff
link.visited.color=#ffffff
; --field: text over the --text progress fill
progress.indicator.text.color=#303f25

[Hacks]
respect_darkness=true
normal_default_pushbutton=true
iconless_pushbutton=false
transparent_dolphin_view=false
transparent_ktitle_label=true
transparent_menutitle=true
blur_translucent=false
no_selection_tint=true

; Base for every widget section below (they inherit it). Text: --text;
; pressed/toggled --text-bright; hover (focus) unchanged.
[PanelButtonCommand]
frame=true
frame.element=button
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
text.normal.color=#cbcfc8
text.focus.color=#cbcfc8
text.press.color=#ffffff
text.toggle.color=#ffffff
text.bold=false
text.italic=false
text.shadow=false
text.margin=true
text.margin.top=3
text.margin.bottom=3
text.margin.left=9
text.margin.right=9
text.iconspacing=4
min_height=24

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=toolbutton
interior.element=toolbutton
text.margin.left=4
text.margin.right=4

[ToolbarButton]
frame.element=toolbutton
interior.element=toolbutton
text.normal.color=#cbcfc8
text.focus.color=#cbcfc8
text.press.color=#ffffff
text.toggle.color=#ffffff

[Dock]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=dock

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#ffffff
text.focus.color=#ffffff
text.bold=false
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9
frame.element=button
interior.element=button

[RadioButton]
inherits=PanelButtonCommand
interior.element=radio
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.press.color=#cbcfc8
text.toggle.color=#cbcfc8

[CheckBox]
inherits=PanelButtonCommand
interior.element=checkbox
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.press.color=#cbcfc8
text.toggle.color=#cbcfc8

; Keyboard focus (pick c): 1px dotted --text box inside the widget.
[Focus]
inherits=PanelButtonCommand
interior=false
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=2

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=6
text.margin.right=6

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.margin.left=9
text.margin.right=9
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
text.margin.left=6
text.margin.right=6
text.press.color=#ffffff
text.toggle.color=#cbcfc8

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=toolbar
indicator.element=toolbar
indicator.size=5
frame.element=toolbar

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider

[SliderCursor]
inherits=PanelButtonCommand
frame=true
frame.element=slidercursor
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.normal.color=#cbcfc8
text.focus.color=#cbcfc8
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior.element=progress-pattern

; Rows in lists, trees and icon views: selected = --panel + --text-bright.
[ItemView]
inherits=PanelButtonCommand
frame=false
interior.element=itemview
frame.element=itemview
text.margin=true
text.margin.top=1
text.margin.bottom=1
text.margin.left=4
text.margin.right=4
text.normal.color=#cbcfc8
text.focus.color=#cbcfc8
text.press.color=#ffffff
text.toggle.color=#ffffff
min_height=0

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=splitter
indicator.element=splitter-grip

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
indicator.element=grip

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior.element=scrollgroove
frame.element=scrollgroove

; Menus: recessed --field list; highlighted row --panel + --text-bright.
[MenuItem]
inherits=PanelButtonCommand
frame=false
interior.element=menuitem
indicator.element=menuitem
min_height=20
text.normal.color=#cbcfc8
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6

[MenuBarItem]
inherits=PanelButtonCommand
frame=true
interior.element=menubaritem
frame.element=menubaritem
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=true
frame.element=menubar
interior.element=menubar
text.normal.color=#cbcfc8

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#ffffff
text.focus.color=#ffffff

[ComboBox]
inherits=PanelButtonCommand
text.press.color=#cbcfc8
text.toggle.color=#cbcfc8

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#cbcfc8

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=false
text.shadow=false
text.margin=0
text.normal.color=#cbcfc8
text.focus.color=#cbcfc8

; Tooltips: like waybar's (raised --field box).
[ToolTip]
inherits=GenericFrame
frame=true
interior=true
frame.element=tooltip
interior.element=tooltip
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.shadow=false
text.margin=true
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
text.normal.color=#cbcfc8

[Window]
interior=false
